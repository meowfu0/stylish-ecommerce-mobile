NODE_ENV=development
PORT=3000
API_PREFIX=api

# Browser origins only. Native Expo requests are not restricted by browser CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8080

# Supabase-hosted PostgreSQL connection. Keep the real value in backend/.env only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:6543/postgres
DATABASE_SSL=true
DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=5000

# Expose Swagger only in approved environments.
SWAGGER_ENABLED=true

# Authentication. Generate independent, high-entropy secrets; never reuse or commit them.
JWT_ACCESS_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-secret-of-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=stylish-api
JWT_AUDIENCE=stylish-expo
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=30m
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Use stylish://auth for native development or http://localhost:8081/auth for local web.
AUTH_FRONTEND_URL=stylish://auth

# Email delivery. Keep preview mode until SMTP credentials are configured.
EMAIL_PROVIDER=preview
EMAIL_PREVIEW_ENABLED=true
EMAIL_PREVIEW_DIRECTORY=.email-previews
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Stylish
EMAIL_REPLY_TO=

# Redis is optional in local development and required in production deployments.
# Use rediss:// for a managed Redis service with TLS. Never commit credentials.
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=
REDIS_KEY_PREFIX=stylish
REDIS_CONNECTION_TIMEOUT_MS=3000
REDIS_DEFAULT_TTL_SECONDS=60
REDIS_IDEMPOTENCY_TTL_SECONDS=300
REDIS_LOCK_TTL_MS=10000

# Used only by the explicit auth:create-admin command when its user does not exist.
INITIAL_ADMIN_PASSWORD=

# Server-only Supabase Storage configuration. Never expose the service-role key
# through Expo, Swagger, Postman, logs, or API responses.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
